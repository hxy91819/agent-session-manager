# Copy this file to .env and fill only the integrations you use.
# The real .env is ignored by Git; never commit access tokens.

# Optional Tencent Meeting enrichment.
TENCENT_MEETING_TOKEN=

# Default Telegram delivery adapter. Alternatively keep these values in the
# user-local ~/.config/agent-notify/config.json file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional model override for the bundled CodeBuddy generator adapter.
DAILY_REPORT_MODEL=
