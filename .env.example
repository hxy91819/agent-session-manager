# Copy this file to .env and fill only the integrations you use.
# The real .env is ignored by Git; never commit access tokens.

# Optional Tencent Meeting enrichment.
TENCENT_MEETING_TOKEN=

# Telegram delivery credentials when REPORT_DELIVERY_PROVIDER=both or telegram.
# Alternatively keep these values in user-local ~/.config/agent-notify/config.json.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Report generator provider: ollama (default) or codebuddy.
REPORT_GENERATOR_PROVIDER=ollama

# Report delivery provider: both (default), local-file, or telegram.
REPORT_DELIVERY_PROVIDER=both
REPORT_LOCAL_REPORT_DIR=.local/agent-work-reports

# Optional model override for the selected report generator provider.
DAILY_REPORT_MODEL=

# Ollama Cloud generator provider.
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=deepseek-v4-flash:0731-cloud
OLLAMA_REASONING_EFFORT=max
OLLAMA_API_KEY=
